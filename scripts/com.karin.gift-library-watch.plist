		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/karin/gift-library/logs/launchd.watch.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/karin/gift-library/logs/launchd.watch.err.log</string>
</dict>
</plist>
