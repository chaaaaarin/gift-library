<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.karin.gift-library-watch</string>
	<!-- 動画公開(19:00 JST)に張り付き、公開された瞬間にプレゼントを出すための見張り。
	     19:01から19:21まで2分おき。毎回やるのはYouTubeの公開済み一覧の取り直しだけで
	     （約10秒・cc/aa/には触らない）、新しい動画を見つけた回だけビルドして公開する。
	     取りこぼした場合は com.karin.gift-library-daily の20:10が拾う。 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/karin/gift-library/scripts/daily_update.sh</string>
		<string>--watch</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>19</integer>
			<key>Minute</key>
			<integer>1</integer>
		</dict>
